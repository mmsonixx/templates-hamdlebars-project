<ul class="menu_list">
  {{#each menu}}
    <li class="menu_item">
      <h2 class="item_subtitle">{{title}}</h2>
      <p class="item_description">{{description}}</p>
      <img src={{photo}} alt={{title}} class="item_photo" />
      <p class="item_price">Ціна: {{price}}</p>
    </li>
  {{/each}}
</ul>